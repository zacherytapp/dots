{
  "mcpServers": {
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "--prefer-offline",
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.7",
        "--tool-preset",
        "developer"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["--prefer-offline", "-y", "chrome-devtools-mcp@1.13.0"]
    },
    "forgejo": {
      "command": "~/.local/bin/forgejo-mcp-claude"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "!\"$HOME/.local/bin/mcp-bearer-header\" context7 | jq -r .Authorization"
      }
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "!\"$HOME/.local/bin/mcp-bearer-header\" github | jq -r .Authorization"
      }
    }
  }
}
