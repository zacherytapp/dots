{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(tree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh repo view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git show-ref:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(node --version)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npm outdated:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(nvim --version:*)",
      "WebFetch(domain:api.open-meteo.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:claudelog.com)",
      "WebFetch(domain:www.eesel.ai)",
      "WebFetch(domain:shipyard.build)"
    ],
    "deny": [
      "Bash(dd *)",
      "Bash(fdisk *)",
      "Bash(mkfs *)",
      "Read(~/.ssh/id_*)",
      "Read(~/.gnupg/**)",
      "Read(~/gpg-secret.asc)",
      "Read(~/age-key.txt)",
      "Read(~/.config/sops/age/keys.txt)",
      "Read(~/.aws/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/hook-doctor.ts\" || echo '{\"systemMessage\":\"hook-doctor: node could not run the Claude Code hooks (not on PATH, or a Node.js without built-in TypeScript support; 24.2+ is needed). bash-guard, secret-guard and the other guards are NOT running this session.\"}'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py idle 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py turn_start 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/secret-guard.ts",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sensitive-data-guard.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py tool_start 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/organize-guard.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/bash-guard.ts",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/consent.py 2>/dev/null || true",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/git-guard.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sf-cli-guard.ts",
            "timeout": 75
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/soql-guard.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sensitive-data-guard.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py turn_start 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "^(Read|WebFetch|WebSearch|Bash|Grep|Agent|Task|Workflow|ReadMcpResourceTool|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/prompt-injection-guard.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/apex-quality.ts",
            "timeout": 75
          }
        ]
      },
      {
        "matcher": "^(Read|Bash|Grep|Glob|WebFetch|WebSearch|Agent|Task|Workflow|ReadMcpResourceTool|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sensitive-data-guard.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py needs_attention 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py turn_end 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sf-stop-check.ts",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sensitive-data-guard.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/state/noctalia/plugins/materialized/community/claude-companion/hooks/pulse.py session_end 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=$HOME/.cache/claude-hooks node $HOME/.claude/hooks/sensitive-data-guard.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — unqueryable here, no remotes configured for this repo",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — origin/HEAD unset, no remotes configured, not queryable via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: no git remotes configured in this repo (~, 0 tracked files) — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — note: this home directory contains sensitive-looking paths such as .claude/.credentials.json, .env, gpg-secret.asc, and Projects/blastbeat/deploy/terraform.tfstate(.backup)",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment — note: Projects/blastbeat/deploy contains live Terraform state and .tf files (cloudflare.tf, coolify.tf, droplet.tf) that should be treated with care",
      "### User-specific",
      "**Primary use of Claude Code**: software development (observed: Plannotator skill usage, noctalia/hyprctl/herdr desktop-environment tooling, system package management via pacman/paru)",
      "**Trusted repo**: The git repository the agent started in (its working directory, ~) and its configured remote(s) — no remotes are currently configured, so no trusted git remote exists",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "skillOverrides": {
    "find-skills": "off",
    "grilling": "off",
    "research": "off",
    "resolving-merge-conflicts": "off",
    "plannotator": "off",
    "plannotator-compound": "off",
    "plannotator-last": "off",
    "plannotator-review": "off",
    "plannotator-setup-goal": "off",
    "plannotator-visual-explainer": "off",
    "sf-logs-debug": "off",
    "sf-org-manage": "off",
    "sf-review-code": "off",
    "sf-scratch-org-cleanup": "off",
    "deslop": "off",
    "grill-with-docs": "off",
    "implement": "off",
    "implement-pr-fixes": "off",
    "merge-pr-into-main": "off",
    "review-code": "off",
    "review-issue": "off",
    "sf-docs": "off",
    "sf-implement": "off",
    "sf-review-issue": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "write-a-skill": "off"
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
