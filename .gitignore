# Editor/app backups that should never be committed
*.bak
*.orig
*.pre-*
*.prebnet

# Runtime state some apps write next to their config
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/.plugins.lock

# Claude Code scratch worktrees
.claude/worktrees/

# Private ssh hosts belong in ~/.ssh/config.d, never here
.ssh/config.d/

# Real secrets live in ~/.config/credstore*, and the 1Password references in
# ~/.config/with-secrets; neither belongs here (see with-secrets)
.config/credstore/
.config/credstore.encrypted/
.config/with-secrets/

# Local-only agent instructions and planning docs
/AGENTS.md
/SPEC.md
/.agents/AGENTS.md
/.agents/CLAUDE.md

# Plannotator's installer writes its skills straight into $HOME and rewrites
# them on every update (see step_plannotator in .local/bin/config/cachy/scripts/dev.sh)
.agents/skills/plannotator*/
.claude/skills/plannotator*
.pi/agent/skills/plannotator*
