[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Writing package lists to the dots repo...
When = PostTransaction
Exec = /usr/bin/runuser -u @USER@ -- /bin/sh -c 'pacman -Qqen > "$1/pkglist.native.txt"; pacman -Qqem > "$1/pkglist.aur.txt" || [ $? -eq 1 ]' paclist @DIR@
