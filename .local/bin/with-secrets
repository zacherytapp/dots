#!/usr/bin/env bash
# usage: with-secrets <name> -- <command> [args...]
#
# Sets <name>'s secrets in <command>'s environment only, so they are never
# exported to every shell (and from there to every agent's Bash tool).
#
# Secret sources, first match wins:
#   ~/.config/credstore/<name>.env      KEY=value, mode 600
#   ~/.config/with-secrets/<name>.env   KEY=op://vault/item/field, resolved by `op run`
#
# `op run` token: $OP_SERVICE_ACCOUNT_TOKEN, else
#   ~/.config/credstore.encrypted/op-service-account   (systemd-creds encrypt --user)
#   ~/.config/credstore/op-service-account             (plain, mode 600)
# The token is removed before <command> starts.
set -euo pipefail

prog=${0##*/}
die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }

private() { (( (8#$(stat -Lc %a "$1") & 8#077) == 0 )); }

[[ $# -ge 3 && $2 == -- ]] || die "usage: $prog <name> -- <command> [args...]"
name=$1
shift 2
[[ $name =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "invalid name: $name"

config=${XDG_CONFIG_HOME:-$HOME/.config}
local_file=$config/credstore/$name.env
refs_file=$config/with-secrets/$name.env

if [[ -e $local_file ]]; then
  private "$local_file" || die "$local_file is readable by group or others (chmod 600 it)"
  n=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    # Report only the line number: the line itself may hold a secret.
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] \
      || die "$local_file:$n: expected KEY=value"
    key=${BASH_REMATCH[2]}
    val=${BASH_REMATCH[3]}
    if [[ $val =~ ^\"(.*)\"$ || $val =~ ^\'(.*)\'$ ]]; then
      val=${BASH_REMATCH[1]}
    fi
    export "$key=$val"
  done <"$local_file"
  unset OP_SERVICE_ACCOUNT_TOKEN
  exec "$@"
fi

[[ -r $refs_file ]] || die "no secrets for '$name': create $refs_file or $local_file"
command -v op >/dev/null || die "1Password CLI (op) is not installed"

if [[ -z ${OP_SERVICE_ACCOUNT_TOKEN:-} ]]; then
  encrypted=$config/credstore.encrypted/op-service-account
  plain=$config/credstore/op-service-account
  if [[ -e $encrypted ]]; then
    OP_SERVICE_ACCOUNT_TOKEN=$(systemd-creds decrypt --user --name=op-service-account "$encrypted" -) \
      || die "could not decrypt $encrypted"
  elif [[ -e $plain ]]; then
    private "$plain" || die "$plain is readable by group or others (chmod 600 it)"
    OP_SERVICE_ACCOUNT_TOKEN=$(<"$plain")
  else
    die "no 1Password service account token in $encrypted or $plain"
  fi
  export OP_SERVICE_ACCOUNT_TOKEN
fi

# --no-masking: masking rewrites the child's stdout, which would corrupt a
# stdio MCP server's JSON-RPC stream. env -u keeps the service account token,
# which can read the whole vault, out of the server's environment; -- keeps a
# command starting with - from being taken as an env option.
exec op run --no-masking --env-file="$refs_file" -- env -u OP_SERVICE_ACCOUNT_TOKEN -- "$@"
