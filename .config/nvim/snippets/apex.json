  "Trigger Template": {
    "body": [
      "trigger ${1:SObjectName}Trigger on ${1:SObjectName} (",
      "\tbefore insert, before update, before delete,",
      "\tafter insert, after update, after delete, after undelete",
      ") {",
      "\tif (Trigger.isBefore) {",
      "\t\tif (Trigger.isInsert) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleBeforeInsert(Trigger.new);",
      "\t\t} else if (Trigger.isUpdate) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleBeforeUpdate(Trigger.oldMap, Trigger.newMap);",
      "\t\t} else if (Trigger.isDelete) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleBeforeDelete(Trigger.oldMap);",
      "\t\t}",
      "\t} else {",
      "\t\tif (Trigger.isInsert) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleAfterInsert(Trigger.newMap);",
      "\t\t} else if (Trigger.isUpdate) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleAfterUpdate(Trigger.oldMap, Trigger.newMap);",
      "\t\t} else if (Trigger.isDelete) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleAfterDelete(Trigger.oldMap);",
      "\t\t} else if (Trigger.isUndelete) {",
      "\t\t\t${1:SObjectName}TriggerHandler.handleAfterUndelete(Trigger.newMap);",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Trigger with handler delegation pattern",
    "prefix": ["triggerTemplate", "trig"],
    "scope": "apex"
  },
