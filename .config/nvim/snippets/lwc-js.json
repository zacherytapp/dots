  "LWC reduceErrors": {
    "body": [
      "reduceErrors(errors) {",
      "\tif (!Array.isArray(errors)) {",
      "\t\terrors = [errors];",
      "\t}",
      "",
      "\treturn errors",
      "\t\t.filter((error) => !!error)",
      "\t\t.map((error) => {",
      "\t\t\tif (Array.isArray(error.body)) {",
      "\t\t\t\treturn error.body.map((e) => e.message);",
      "\t\t\t} else if (error.body && typeof error.body.message === 'string') {",
      "\t\t\t\treturn error.body.message;",
      "\t\t\t} else if (typeof error.message === 'string') {",
      "\t\t\t\treturn error.message;",
      "\t\t\t}",
      "\t\t\treturn error.statusText;",
      "\t\t})",
      "\t\t.reduce((prev, curr) => prev.concat(curr), []);",
      "}"
    ],
    "description": "Error reduction utility for LWC",
    "prefix": ["reduceErrors", "errorHandler"],
    "scope": "javascript"
  }
