      "describe('c-${2:componentName}', () => {",
      "\tafterEach(() => {",
      "\t\twhile (document.body.firstChild) {",
      "\t\t\tdocument.body.removeChild(document.body.firstChild);",
      "\t\t}",
      "\t\tjest.clearAllMocks();",
      "\t});",
      "",
      "\tfunction createComponent() {",
      "\t\tconst element = createElement('c-${2:componentName}', {",
      "\t\t\tis: ${1:ComponentName}",
      "\t\t});",
      "\t\tdocument.body.appendChild(element);",
      "\t\treturn element;",
      "\t}",
      "",
      "\tit('${3:should render component}', () => {",
      "\t\tconst element = createComponent();",
