  "LWC LMS Subscribe": {
    "body": [
      "import { subscribe, unsubscribe, APPLICATION_SCOPE, MessageContext } from 'lightning/messageService';",
      "import ${1:CHANNEL_NAME} from '@salesforce/messageChannel/${2:ChannelApiName}__c';",
      "",
      "@wire(MessageContext)",
      "messageContext;",
      "",
      "subscription = null;",
      "",
      "connectedCallback() {",
      "\tthis.subscribeToMessageChannel();",
      "}",
      "",
      "disconnectedCallback() {",
      "\tthis.unsubscribeToMessageChannel();",
      "}",
      "",
      "subscribeToMessageChannel() {",
      "\tif (!this.subscription) {",
      "\t\tthis.subscription = subscribe(",
      "\t\t\tthis.messageContext,",
      "\t\t\t${1:CHANNEL_NAME},",
      "\t\t\t(message) => this.handleMessage(message),",
      "\t\t\t{ scope: APPLICATION_SCOPE }",
      "\t\t);",
      "\t}",
      "}",
      "",
      "unsubscribeToMessageChannel() {",
      "\tunsubscribe(this.subscription);",
      "\tthis.subscription = null;",
      "}",
      "",
      "handleMessage(message) {",
      "\t$0",
      "}"
    ],
    "description": "Full Lightning Message Service subscription pattern",
    "prefix": ["lmsSubscribe", "messageSubscribe"],
    "scope": "javascript"
  },
