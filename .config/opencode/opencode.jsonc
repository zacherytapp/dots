{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "--prefer-offline",
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.7",
        "--tool-preset",
        "developer"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "--prefer-offline", "-y", "chrome-devtools-mcp@1.13.0"]
    },
    "forgejo": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/forgejo-mcp-claude"]
    },
    // Auth headers for these come from plugins/mcp-headers-helper.js.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false
    }
  }
}
