{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest", "--tool-preset", "developer"]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "forgejo": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/forgejo-mcp-claude"]
    },
    // Authorization for context7 and github comes from plugins/mcp-headers-helper.js.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false
    }
  }
}
