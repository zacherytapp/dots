# Private hosts (homelab, Tailscale, self-hosted git) live in untracked files
# under ~/.ssh/config.d/ so their names stay out of this public repo.
Include config.d/*

Host *
	IdentityAgent ~/.1password/agent.sock

Host github.com
	User zacherytapp
	IdentityFile ~/.ssh/github
	ControlMaster auto
	ControlPath ~/.ssh/control/%r@%h:%p
	ControlPersist 300
